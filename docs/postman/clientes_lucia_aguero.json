            {
            "name": "POST login (obtiene token)",
            "event": [
                {
                "listen": "test",
                "script": {
                    "type": "text/javascript",
                    "exec": [
                    "const res = pm.response.json();\nif (res && res.data && res.data.token) {\n    pm.collectionVariables.set('token', res.data.token);\n}"
                    ]
                }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                }
                ],
                "body": {
                "mode": "raw",
                "raw": "{\n  \"email\": \"admin@taller.com\",\n  \"password\": \"taller123\"\n}",
                "options": {
                    "raw": {
                    "language": "text"
                    }
                }
                },
                "url": {
                "raw": "{{url_backend}}/auth/login",
                "host": [
                    "{{url_backend}}"
                ],
                "path": [
                    "auth",
                    "login"
                ]
                }
            },
            "response": []
            }
        ]
